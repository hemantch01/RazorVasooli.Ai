// RazorVasooli.Ai — Prisma Schema
// Full domain persistence (Phase P3)
// Migrate: npx prisma migrate dev --name <name>

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AuditEntry {
  seq       Int      @id
  ts        DateTime
  eventType String
  payload   Json
  prevHash  String
  hash      String
}

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  name         String   @default("Merchant")
  passwordHash String
  salt         String
  role         String   @default("merchant_admin")
  createdAt    DateTime @default(now())
}


