# ── PostgreSQL (optional — enables durable audit ledger + user accounts) ────
# Start Postgres via: docker compose up -d
DATABASE_URL=postgres://razorvasooli:razorvasooli@localhost:5432/razorvasooli

# ── Authentication ───────────────────────────────────────────────────────────
REQUIRE_AUTH=true
AUTH_SECRET=change-me-to-a-long-random-string
ADMIN_EMAIL=admin@razorvasooli.in
ADMIN_PASSWORD=changeme123

# ── Telegram Live Channel (you = customer, Gemini = agent) ──────────────────
# 1. Open Telegram → talk to @BotFather → /newbot → copy the token here
# 2. Message your bot on Telegram — the AI agent replies and can send
#    real Razorpay test payment links when RAZORPAY keys are set above.
TELEGRAM_BOT_TOKEN=
# Optional (production): webhook mode instead of polling.
# Set TELEGRAM_WEBHOOK_URL to https://<your-host>/api/telegram/webhook
# and a random TELEGRAM_WEBHOOK_SECRET (verified on every call).
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=

# Demo due amount for the Telegram session (INR)
SESSION_AMOUNT_INR=2499

# ── Real Email Delivery via SMTP (optional) ─────────────────────────────────
# Local testing with docker compose Mailpit:
SMTP_HOST=localhost
SMTP_PORT=1025
# Production (SES/SendGrid/Resend): also set SMTP_USER, SMTP_PASS, SMTP_SECURE=true
SMTP_FROM=RazorVasooli.Ai <recovery@razorvasooli.demo>

# ── Inbound Email Replies via IMAP (the "working Gmail system") ─────────────
# Customer replies land in this mailbox → AI reads them → AI replies back.
# For Gmail: enable 2FA → create an App Password → use it below.
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=your-recovery-inbox@gmail.com
IMAP_PASS=your-gmail-app-password
IMAP_MAILBOX=INBOX
IMAP_POLL_SECONDS=30

# Razorpay API Credentials
# Get your test keys from https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=YourWebhookSecretHere

# Gemini API Key (optional — enables real Hinglish TTS voice calls / IVR
# AND the Telegram agent brain; without it the deterministic fallback runs)
GEMINI_API_KEY=
# Chat/transcription model for the Telegram agent + voice notes (must be a
# valid flash model your key can access)
GEMINI_MODEL=gemini-2.5-flash

# LLM Gateway (optional — Groq or other OpenAI-compatible provider)
LLM_API_KEY=

# Server Configuration
PORT=5000
HOST=127.0.0.1
NODE_ENV=development

# ── Phase H1: Durable risk-event queue (BullMQ) ──────────────────────────────
# Set to redis://localhost:6379 (docker compose) to enable durable webhook
# processing. Unset = direct in-process publishing (previous behavior).
REDIS_URL=

# Phase C1: sale info the Telegram agent may offer during cart recovery
NEXT_SALE_MESSAGE=Next week End-of-Season Sale - extra 15% off on top of your discount!
